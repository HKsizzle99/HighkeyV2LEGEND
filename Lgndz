--// MSFX PREMIUM MONOX
--// VISUAL-ONLY UI
--// NO KICK / NETWORK / FLING / PLAYER FUNCTIONALITY

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer

local function BuildMSFX()
	--// Remove an existing copy
	local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

	local Existing = PlayerGui:FindFirstChild("MSFX_PREMIUM_MONOX")
	if Existing then
		Existing:Destroy()
	end

	--// Main GUI
	local ScreenGui = Instance.new("ScreenGui")
	ScreenGui.Name = "MSFX_PREMIUM_MONOX"
	ScreenGui.ResetOnSpawn = false
	ScreenGui.IgnoreGuiInset = true
	ScreenGui.Parent = PlayerGui

	--// Main frame
	local Main = Instance.new("Frame")
	Main.Name = "Main"
	Main.Size = UDim2.new(0, 820, 0, 610)
	Main.Position = UDim2.new(0.5, -410, 0.5, -305)
	Main.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
	Main.BorderSizePixel = 0
	Main.ClipsDescendants = true
	Main.Parent = ScreenGui

	local MainCorner = Instance.new("UICorner")
	MainCorner.CornerRadius = UDim.new(0, 14)
	MainCorner.Parent = Main

	local Stroke = Instance.new("UIStroke")
	Stroke.Color = Color3.fromRGB(55, 55, 65)
	Stroke.Thickness = 1
	Stroke.Parent = Main

	--// Header
	local Header = Instance.new("Frame")
	Header.Name = "Header"
	Header.Size = UDim2.new(1, 0, 0, 65)
	Header.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
	Header.BorderSizePixel = 0
	Header.Parent = Main

	local HeaderTitle = Instance.new("TextLabel")
	HeaderTitle.Size = UDim2.new(1, -100, 1, 0)
	HeaderTitle.Position = UDim2.new(0, 22, 0, 0)
	HeaderTitle.BackgroundTransparency = 1
	HeaderTitle.Text = "✦ MSFX PREMIUM MONOX ✦"
	HeaderTitle.TextColor3 = Color3.fromRGB(235, 235, 240)
	HeaderTitle.TextSize = 21
	HeaderTitle.Font = Enum.Font.GothamBold
	HeaderTitle.TextXAlignment = Enum.TextXAlignment.Left
	HeaderTitle.Parent = Header

	--// Close button
	local Close = Instance.new("TextButton")
	Close.Name = "Close"
	Close.Size = UDim2.new(0, 42, 0, 42)
	Close.Position = UDim2.new(1, -54, 0, 11)
	Close.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
	Close.Text = "×"
	Close.TextColor3 = Color3.fromRGB(230, 230, 235)
	Close.TextSize = 27
	Close.Font = Enum.Font.GothamBold
	Close.AutoButtonColor = false
	Close.Parent = Header

	local CloseCorner = Instance.new("UICorner")
	CloseCorner.CornerRadius = UDim.new(0, 9)
	CloseCorner.Parent = Close

	Close.MouseButton1Click:Connect(function()
		ScreenGui:Destroy()
	end)

	--// Sidebar
	local Sidebar = Instance.new("Frame")
	Sidebar.Name = "Sidebar"
	Sidebar.Size = UDim2.new(0, 190, 1, -65)
	Sidebar.Position = UDim2.new(0, 0, 0, 65)
	Sidebar.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
	Sidebar.BorderSizePixel = 0
	Sidebar.Parent = Main

	local SidebarLayout = Instance.new("UIListLayout")
	SidebarLayout.Padding = UDim.new(0, 6)
	SidebarLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	SidebarLayout.SortOrder = Enum.SortOrder.LayoutOrder
	SidebarLayout.Parent = Sidebar

	local SidebarPadding = Instance.new("UIPadding")
	SidebarPadding.PaddingTop = UDim.new(0, 14)
	SidebarPadding.PaddingLeft = UDim.new(0, 10)
	SidebarPadding.PaddingRight = UDim.new(0, 10)
	SidebarPadding.Parent = Sidebar

	--// Content
	local Content = Instance.new("Frame")
	Content.Name = "Content"
	Content.Size = UDim2.new(1, -190, 1, -65)
	Content.Position = UDim2.new(0, 190, 0, 65)
	Content.BackgroundTransparency = 1
	Content.Parent = Main

	local PageTitle = Instance.new("TextLabel")
	PageTitle.Name = "PageTitle"
	PageTitle.Size = UDim2.new(1, -40, 0, 45)
	PageTitle.Position = UDim2.new(0, 20, 0, 10)
	PageTitle.BackgroundTransparency = 1
	PageTitle.TextColor3 = Color3.fromRGB(240, 240, 245)
	PageTitle.TextSize = 24
	PageTitle.Font = Enum.Font.GothamBold
	PageTitle.TextXAlignment = Enum.TextXAlignment.Left
	PageTitle.Parent = Content

	local PageDescription = Instance.new("TextLabel")
	PageDescription.Name = "PageDescription"
	PageDescription.Size = UDim2.new(1, -40, 0, 25)
	PageDescription.Position = UDim2.new(0, 20, 0, 48)
	PageDescription.BackgroundTransparency = 1
	PageDescription.TextColor3 = Color3.fromRGB(125, 125, 135)
	PageDescription.TextSize = 13
	PageDescription.Font = Enum.Font.Gotham
	PageDescription.TextXAlignment = Enum.TextXAlignment.Left
	PageDescription.Parent = Content

	--// Scroll area
	local Scroll = Instance.new("ScrollingFrame")
	Scroll.Name = "Scroll"
	Scroll.Size = UDim2.new(1, -40, 1, -95)
	Scroll.Position = UDim2.new(0, 20, 0, 90)
	Scroll.BackgroundTransparency = 1
	Scroll.BorderSizePixel = 0
	Scroll.ScrollBarThickness = 4
	Scroll.ScrollBarImageColor3 = Color3.fromRGB(75, 75, 85)
	Scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	Scroll.Parent = Content

	local ListLayout = Instance.new("UIListLayout")
	ListLayout.Padding = UDim.new(0, 7)
	ListLayout.SortOrder = Enum.SortOrder.LayoutOrder
	ListLayout.Parent = Scroll

	ListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		Scroll.CanvasSize = UDim2.new(
			0,
			0,
			0,
			ListLayout.AbsoluteContentSize.Y + 15
		)
	end)

	--// Items
	local Items = {
		"Acoustic Guitar",
		"American Flag",
		"Balloon",
		"Banana",
		"Banjo",
		"Basketball",
		"Bathroom Shower",
		"Bench",
		"Big Bell",
		"Bubble Blower",
		"Bugle",
		"Campfire",
		"Cheese Pizza",
		"Chicken",
		"Chicken Boy",
		"Chicken Leg",
		"Chicken Wing",
		"Cracked Stool",
		"Crystal",
		"Cursed Alarm Clock",
		"Daycare Table",
		"Die",
		"Disco Cube",
		"Donut",
		"Edgy desk",
		"Flatscreen Television",
		"French Fries",
		"Glass Box",
		"Golden Toilet",
		"Hotdog",
		"Jukebox",
		"Little UFO",
		"Lyre",
		"Mysterious Mushroom",
		"Ocarina",
		"Orange Bed",
		"Post Horn",
		"Purple Armchair",
		"Rhythm Maker",
		"Rubber Duck",
		"Secret Area",
		"Shelf (Traditional)",
		"Short Daycare Box Thing",
		"Snowman",
		"Sparkling Poop!",
		"Spooky Chair",
		"Green Spotlight",
		"Red Spotlight",
		"Blue Spotlight",
		"White Spotlight",
		"Trumpet",
		"Violin"
	}

	local AntiKickItems = Items
	local NetworkItems = Items
	local GucciItems = Items

	local MiscItems = {
		"Premium Mode",
		"Developer Mode",
		"Debug Mode",
		"Experimental",
		"Visual Mode",
		"Interface Lock",
		"Safe Mode",
		"Test Mode"
	}

	--// State
	local EnabledCount = 0
	local ToggleStates = {}

	local Counter = Instance.new("TextLabel")
	Counter.Name = "Counter"
	Counter.Size = UDim2.new(0, 170, 0, 30)
	Counter.Position = UDim2.new(1, -190, 0, 18)
	Counter.BackgroundTransparency = 1
	Counter.Text = "0 TOGGLES ENABLED"
	Counter.TextColor3 = Color3.fromRGB(135, 135, 145)
	Counter.TextSize = 11
	Counter.Font = Enum.Font.GothamBold
	Counter.TextXAlignment = Enum.TextXAlignment.Right
	Counter.Parent = Header

	local function UpdateCounter()
		Counter.Text = tostring(EnabledCount) .. " TOGGLES ENABLED"
	end

	--// Clear page
	local function ClearPage()
		for _, Child in ipairs(Scroll:GetChildren()) do
			if Child:IsA("Frame") then
				Child:Destroy()
			end
		end
	end

	--// Create toggle row
	local function CreateToggle(ItemName, Suffix)
		local Row = Instance.new("Frame")
		Row.Size = UDim2.new(1, -5, 0, 52)
		Row.BackgroundColor3 = Color3.fromRGB(22, 22, 27)
		Row.BorderSizePixel = 0
		Row.Parent = Scroll

		local Corner = Instance.new("UICorner")
		Corner.CornerRadius = UDim.new(0, 8)
		Corner.Parent = Row

		local RowStroke = Instance.new("UIStroke")
		RowStroke.Color = Color3.fromRGB(38, 38, 45)
		RowStroke.Thickness = 1
		RowStroke.Parent = Row

		local Label = Instance.new("TextLabel")
		Label.Size = UDim2.new(1, -110, 1, 0)
		Label.Position = UDim2.new(0, 15, 0, 0)
		Label.BackgroundTransparency = 1
		Label.Text = ItemName .. Suffix
		Label.TextColor3 = Color3.fromRGB(220, 220, 225)
		Label.TextSize = 14
		Label.Font = Enum.Font.GothamMedium
		Label.TextXAlignment = Enum.TextXAlignment.Left
		Label.Parent = Row

		local Toggle = Instance.new("TextButton")
		Toggle.Size = UDim2.new(0, 78, 0, 32)
		Toggle.Position = UDim2.new(1, -90, 0.5, -16)
		Toggle.BackgroundColor3 = Color3.fromRGB(32, 32, 38)
		Toggle.Text = "[ OFF ]"
		Toggle.TextColor3 = Color3.fromRGB(135, 135, 145)
		Toggle.TextSize = 11
		Toggle.Font = Enum.Font.GothamBold
		Toggle.AutoButtonColor = false
		Toggle.Parent = Row

		local ToggleCorner = Instance.new("UICorner")
		ToggleCorner.CornerRadius = UDim.new(0, 7)
		ToggleCorner.Parent = Toggle

		local Key = tostring(ItemName) .. tostring(Suffix)

		ToggleStates[Key] = false

		Toggle.MouseButton1Click:Connect(function()
			ToggleStates[Key] = not ToggleStates[Key]

			if ToggleStates[Key] then
				EnabledCount += 1
				Toggle.Text = "[ ON ]"
				Toggle.TextColor3 = Color3.fromRGB(170, 255, 190)
				Toggle.BackgroundColor3 = Color3.fromRGB(28, 55, 36)
			else
				EnabledCount -= 1
				Toggle.Text = "[ OFF ]"
				Toggle.TextColor3 = Color3.fromRGB(135, 135, 145)
				Toggle.BackgroundColor3 = Color3.fromRGB(32, 32, 38)
			end

			UpdateCounter()
		end)
	end

	--// Pages
	local Pages = {
		["Anti-Kick"] = {
			Items = AntiKickItems,
			Description = "Protection against unwanted sessions",
			Suffix = " Anti-Kick"
		},

		["Protection"] = {
			Items = NetworkItems,
			Description = "Visual protection configuration",
			Suffix = " Protection"
		},

		["Network"] = {
			Items = NetworkItems,
			Description = "Network configuration",
			Suffix = " Anti-Network"
		},

		["Gucci"] = {
			Items = GucciItems,
			Description = "Premium visual configuration",
			Suffix = " Gucci"
		},

		["Misc"] = {
			Items = MiscItems,
			Description = "Miscellaneous visual configuration",
			Suffix = ""
		}
	}

	--// Page buttons
	local PageButtons = {}

	local PageOrder = {
		"Anti-Kick",
		"Protection",
		"Network",
		"Gucci",
		"Misc"
	}

	local PageIcons = {
		["Anti-Kick"] = "🛡",
		["Protection"] = "◈",
		["Network"] = "⌁",
		["Gucci"] = "✦",
		["Misc"] = "⚙"
	}

	local CurrentPage

	local function ShowPage(PageName)
		local Page = Pages[PageName]
		if not Page then
			return
		end

		CurrentPage = PageName

		PageTitle.Text = PageName
		PageDescription.Text = Page.Description

		ClearPage()

		for _, ItemName in ipairs(Page.Items) do
			CreateToggle(ItemName, Page.Suffix)
		end

		for Name, Button in pairs(PageButtons) do
			if Name == PageName then
				Button.BackgroundColor3 = Color3.fromRGB(38, 38, 46)
				Button.TextColor3 = Color3.fromRGB(245, 245, 250)
			else
				Button.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
				Button.TextColor3 = Color3.fromRGB(145, 145, 155)
			end
		end

		Scroll.CanvasPosition = Vector2.new(0, 0)
	end

	for Index, PageName in ipairs(PageOrder) do
		local Button = Instance.new("TextButton")
		Button.Name = PageName .. "Button"
		Button.Size = UDim2.new(1, 0, 0, 48)
		Button.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
		Button.BorderSizePixel = 0
		Button.Text = "   " .. PageIcons[PageName] .. "   " .. PageName
		Button.TextColor3 = Color3.fromRGB(145, 145, 155)
		Button.TextSize = 13
		Button.Font = Enum.Font.GothamMedium
		Button.TextXAlignment = Enum.TextXAlignment.Left
		Button.AutoButtonColor = false
		Button.LayoutOrder = Index
		Button.Parent = Sidebar

		local ButtonCorner = Instance.new("UICorner")
		ButtonCorner.CornerRadius = UDim.new(0, 8)
		ButtonCorner.Parent = Button

		PageButtons[PageName] = Button

		Button.MouseButton1Click:Connect(function()
			ShowPage(PageName)
		end)
	end

	--// Dragging
	local Dragging = false
	local DragStart
	local StartPosition

	Header.InputBegan:Connect(function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1
			or Input.UserInputType == Enum.UserInputType.Touch then

			Dragging = true
			DragStart = Input.Position
			StartPosition = Main.Position

			Input.Changed:Connect(function()
				if Input.UserInputState == Enum.UserInputState.End then
					Dragging = false
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(Input)
		if Dragging and (
			Input.UserInputType == Enum.UserInputType.MouseMovement
			or Input.UserInputType == Enum.UserInputType.Touch
		) then

			local Delta = Input.Position - DragStart

			Main.Position = UDim2.new(
				StartPosition.X.Scale,
				StartPosition.X.Offset + Delta.X,
				StartPosition.Y.Scale,
				StartPosition.Y.Offset + Delta.Y
			)
		end
	end)

	--// Opening animation
	local OriginalPosition = Main.Position

	Main.Position = UDim2.new(
		OriginalPosition.X.Scale,
		OriginalPosition.X.Offset,
		OriginalPosition.Y.Scale,
		OriginalPosition.Y.Offset + 25
	)

	Main.BackgroundTransparency = 1

	TweenService:Create(
		Main,
		TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		{
			Position = OriginalPosition,
			BackgroundTransparency = 0
		}
	):Play()

	--// Default page
	ShowPage("Anti-Kick")

	return ScreenGui
end

return BuildMSFX
